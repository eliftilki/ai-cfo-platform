# AI CFO API service environment
# Copy this file to apps/api/.env for local development.
# Do not commit real secrets.

# -------------------------------------------------------------------
# Runtime
# -------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Optional: used when running the API service from scripts or Docker.
API_SERVICE_HOST=0.0.0.0
API_SERVICE_PORT=8000

# -------------------------------------------------------------------
# Source operational Supabase database
# Required for source data access and normalization-backed dashboard flows.
# If these are empty, source repository and refresh flows cannot read source data.
# -------------------------------------------------------------------
SOURCE_SUPABASE_URL=
SOURCE_SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------------
# AI CFO Supabase database
# Required for auth context, company lookup, dashboard data, simulations,
# agent run persistence, and normalized AI CFO tables.
# If these are empty, the API service fails validation at startup.
# -------------------------------------------------------------------
AI_CFO_SUPABASE_URL=
AI_CFO_SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------------
# Supabase Auth
# SUPABASE_AUTH_BASE_URL is optional; when empty, the service uses:
#   AI_CFO_SUPABASE_URL + /auth/v1
#
# SUPABASE_JWT_SECRET is required only for code paths that validate JWTs
# locally with apps/api/app/security/jwt_service.py. Current auth routes
# primarily validate tokens through Supabase Auth, but set this for a
# complete production-like setup.
# -------------------------------------------------------------------
SUPABASE_AUTH_BASE_URL=
SUPABASE_JWT_SECRET=

# -------------------------------------------------------------------
# Agent service
# Required for /ask and /simulations routes. If this is wrong or empty,
# the API can start but AI CFO analysis/simulation calls will fail.
# -------------------------------------------------------------------
AGENT_SERVICE_BASE_URL=http://localhost:8001

# -------------------------------------------------------------------
# Optional Gemini key for API-side Gemini connector.
# The main LLM analysis runs in apps/agent_service, but keep this set if
# API-side Gemini utilities are enabled.
# -------------------------------------------------------------------
GEMINI_API_KEY=

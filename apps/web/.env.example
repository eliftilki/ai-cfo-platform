# AI CFO Web App environment
# Copy this file to apps/web/.env.local for local development.
# Do not commit real secrets.

# -------------------------------------------------------------------
# Fallback OpenAI chat route
# Used only when the local API chat route is not forwarded to the AI CFO
# backend. The primary product flow should use CFO_BACKEND_CHAT_URL plus
# a signed user session/access token.
# -------------------------------------------------------------------
OPENAI_API_KEY=

# -------------------------------------------------------------------
# AI CFO backend API
# Base URL of apps/api. Both http://localhost:8000 and
# http://localhost:8000/ask are accepted by the frontend helper.
# If empty, the frontend defaults to http://localhost:8000.
# -------------------------------------------------------------------
CFO_BACKEND_CHAT_URL=http://localhost:8000

# -------------------------------------------------------------------
# Company context
# Required only for non-authenticated/local demo flows that do not obtain
# company_id from the login session. In the signed-in flow, the company
# context is stored after /auth/login.
# -------------------------------------------------------------------
CFO_COMPANY_ID=

# -------------------------------------------------------------------
# Optional backend bearer token
# For quick backend demos without passing a browser session access token.
# Leave empty for the normal signed-in product flow.
# -------------------------------------------------------------------
CFO_BACKEND_API_KEY=

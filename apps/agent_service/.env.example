# AI CFO Agent Service environment
# Copy this file to apps/agent_service/.env for local development.
# Do not commit real secrets.

# -------------------------------------------------------------------
# Runtime
# -------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Optional: used when running the agent service from scripts or Docker.
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8001

# -------------------------------------------------------------------
# AI CFO Supabase database
# Required for agent data reads, agent run persistence, simulations,
# normalized cashflow/marketing metrics, and output contracts.
# If these are empty, the agent service fails validation at startup.
# -------------------------------------------------------------------
AI_CFO_SUPABASE_URL=
AI_CFO_SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------------
# Gemini
# Required for LLM summaries, intent fallback parsing, time parsing,
# simulation parsing, and simulation explanation.
# If empty, deterministic metrics can still be computed in some paths,
# but LLM-backed analysis and demo-quality natural language responses fail.
# -------------------------------------------------------------------
GEMINI_API_KEY=

# Optional: parser model for natural-language what-if simulations.
SIMULATION_AGENT_MODEL=gemini-2.5-flash
